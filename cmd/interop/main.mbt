///|
/// Actual MoonBit output for the independent Rust decoder. No reference bytes
/// are read by this command; every repair is generated by the library.
fn main {
  println("[")
  let sizes = [1, 2, 3, 9, 10, 11, 16, 18, 32, 64, 128, 256]
  for index in 0..<sizes.length() {
    let k = sizes[index]
    let size = 8
    let length = k * size - (if k > 1 { 1 } else { 0 })
    let source = @buffer.Buffer::Buffer()
    for i in 0..<length {
      source.write_byte(((i * 17 + 11) % 256).to_byte())
    }
    let data = source.to_bytes()
    let encoder = @rq.Encoder::new(data, size).unwrap()
    println(
      "{\"k\":\{k},\"size\":8,\"data\":\"\{@hex.encode(data[:])}\",\"packets\":[",
    )
    let ids : Array[Int32] = []
    for id in 0..<k {
      if id % 3 != 0 {
        ids.push(id)
      }
    }
    for id in k..<(k + (k + 2) / 3 + 8) {
      ids.push(id)
    }
    for position in 0..<ids.length() {
      let packet = encoder.packet(ids[position]).unwrap().serialize()
      let suffix = if position + 1 == ids.length() { "" } else { "," }
      println("\"\{@hex.encode(packet[:])}\"\{suffix}")
    }
    let suffix = if index + 1 == sizes.length() { "" } else { "," }
    println("]}\{suffix}")
  }
  println("]")
}
