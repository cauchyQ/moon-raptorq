  let packets = [
    "000000000b1c2d3e4f607182", "000000010b1c2d3e4f607182", "000000026c79606652b534dd",
    "00000003dad9e5749d31e9fe", "0000000488be21fb0255f9ba", "00000005bbc1c7f9cb2e324a",
