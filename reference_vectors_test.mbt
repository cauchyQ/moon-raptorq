    "0000015937dd75bd5ddf57d9", "0000015a7778e4c98bf0838c", "0000015b9f05a2c938714ec7",
    "0000015cd17cef824da3e677", "0000015d8a4b1399421a9f11",
  ]
  for raw in packets {
    let expected = encoder.config().parse_packet(@hex.decode(raw)).unwrap()
    let packet = encoder.packet(expected.id()).unwrap()
    assert_eq(packet.serialize(), expected.serialize())
    if packet.id() >= 256 || packet.id() % 3 != 0 {
      ignore(receiver.push(expected).unwrap())
    }
  }
  assert_eq(receiver.decode().unwrap(), Some(source))
}

///|
test "Rust object partition vector 0" {
  let data = @hex.decode(
    "0b1c2d3e4f60718293a4b5c6d7e8f90a1b2c3d4e5f708192a3b4c5d6e7f8091a2b3c4d5e6f8091a2b3c4d5e6f708192a3b4c5d6e7f",
  )
  let config = @moon-raptorq.ObjectConfig::new(data.length(), 4, 3).unwrap()
  let decoder = @moon-raptorq.ObjectDecoder::new(config).unwrap()
  let packets = [
    "000000014f607182", "0000000293a4b5c6", "000000041b2c3d4e", "000000053d83422f",
    "00000006fe32cff3", "000000074a030503", "000000081cca189d", "00000009e1a836b1",
    "0000000a7c3ff96d", "0000000b7479a391", "0000000cc637df9a", "0000000d69d161a6",
    "0000000ecd8861db", "01000001a3b4c5d6", "01000002e7f8091a", "010000046f8091a2",
    "01000005a3e3be73", "01000006b9a17e16", "01000007bb67f5dc", "0100000837f7bbe3",
    "010000092e748d5d", "0100000aa3dae9ec", "0100000b511cdf29", "0100000cc6def072",
    "0100000d9eb47eb2", "0100000e7d805231", "02000001f708192a", "020000023b4c5d6e",
    "02000004d8d3fd8f", "020000053dd32a3c", "02000006b395666e", "02000007fb793ef7",
    "02000008c0c08040", "0200000917d30e74", "0200000a32ce8256", "0200000be5795c33",
    "0200000cf1cda719", "0200000d99ecc9a6",
  ]
  for packet in packets.rev() {
    ignore(decoder.push_bytes(@hex.decode(packet)).unwrap())
  }
  assert_eq(decoder.decode(), Some(data))
}

